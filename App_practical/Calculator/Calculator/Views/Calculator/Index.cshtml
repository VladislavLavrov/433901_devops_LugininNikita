@{
    ViewData["Title"] = "Калькулятор";
}

<div class="calculator-container">
    <div class="calculator-card">

        <div class="calculator-icon">÷</div>

        <h1>Калькулятор</h1>

        <form asp-controller="Calculator"
              asp-action="Calculate"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="num1">Первое число</label>
                <input type="number"
                       step="any"
                       name="num1"
                       id="num1"
                       class="form-control"
                       value="@ViewBag.Num1"
                       placeholder="Введите число"
                       required />
            </div>

            <div class="form-group">
                <label for="operation">Операция</label>
                <select name="operation"
                        id="operation"
                        class="form-select">

                    <option value="add"
                            selected="@(ViewBag.Operation?.ToString() == "add")">
                        Сложение (+)
                    </option>

                    <option value="subtract"
                            selected="@(ViewBag.Operation?.ToString() == "subtract")">
                        Вычитание (−)
                    </option>

                    <option value="multiply"
                            selected="@(ViewBag.Operation?.ToString() == "multiply")">
                        Умножение (×)
                    </option>

                    <option value="divide"
                            selected="@(ViewBag.Operation?.ToString() == "divide")">
                        Деление (÷)
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label for="num2">Второе число</label>
                <input type="number"
                       step="any"
                       name="num2"
                       id="num2"
                       class="form-control"
                       value="@ViewBag.Num2"
                       placeholder="Введите число"
                       required />
            </div>

            <button type="submit" class="calculate-button">
                Выполнить расчёт
            </button>
        </form>

        ViewBag.Result != null
        {
        <div class="result-box">
            <div class="result-label">Результат</div>
            <div class="result-value">@ViewBag.Result</div>
        </div>
        }

        ViewBag.Error != null
        {
        <div class="error-box">
            @ViewBag.Error
        </div>
        }

        <div class="calculation-hint">
            Поддерживаются сложение, вычитание, умножение и деление
        </div>

    </div>
</div>