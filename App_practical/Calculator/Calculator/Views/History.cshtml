@id1103110420 (@model) List<Calculator.Models.Calculation>

@{
    ViewData["Title"] = "История вычислений";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>История вычислений</h1>
            <p class="text-muted mb-0">
                Все операции, сохранённые в базе данных
            </p>
        </div>
        <a asp-controller="Calculator"
           asp-action="Index"
           class="btn btn-outline-primary">
            К калькулятору
        </a>
    </div>

    Model.Count == 0
    {
        <div class="alert alert-info">
            История вычислений пока пуста.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Первое число</th>
                        <th>Операция</th>
                        <th>Второе число</th>
                        <th>Результат</th>
                        <th>Дата и время (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    var item in Model
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FirstNumber</td>
                            <td>
                                @(item.Operation switch
                                {
                                    "add" => "+",
                                    "subtract" => "−",
                                    "multiply" => "×",
                                    "divide" => "÷",
                                    _ => item.Operation
                                })
                            </td>
                            <td>@item.SecondNumber</td>
                            <td><strong>@item.Result</strong></td>
                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        <a asp-controller="Calculator"
           asp-action="History"
           class="btn btn-primary">
            Обновить историю
        </a>
    </div>
</div>